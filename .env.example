# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY='change-me'
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Security
# HTTPS: set True once the server has a TLS certificate.
HTTPS=False
# ADMIN_URL: use something hard to guess in production, e.g. manage-7f3k/
ADMIN_URL=admin/
# Minutes without activity before a user is signed out.
SESSION_IDLE_MINUTES=30

# Email (leave EMAIL_HOST empty in development: mails are printed to the console)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_USE_TLS=True

# Company (printed on invoices / ZATCA QR)
COMPANY_NAME=AFAQ ALSIYANAH ALDAWLIYAH EST
COMPANY_NAME_AR=مؤسسة آفاق الصيانة الدولية
COMPANY_VAT_NUMBER=300000000000003
COMPANY_CR_NUMBER=
COMPANY_ADDRESS=Riyadh, Saudi Arabia
INVOICE_PAYMENT_TERMS_DAYS=30

DB_NAME=afaq_db
DB_USER=afaq_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
